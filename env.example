# MacPocket environment configuration — copy to .env and edit.
# (Checked in as "env.example" because "*.env.*" patterns are gitignored.)

# Transcription backend: auto | local | openai | groq | assembler
# "auto" prefers configured free-tier keys (groq, assembler) over paid OpenAI,
# and falls back to local Whisper when no API key is set.
TRANSCRIPTION_BACKEND=groq

# --- Free API tiers (pick one) ---
# Groq: free key at https://console.groq.com/keys  (recommended)
GROQ_API_KEY=gsk_your_key_here
#GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# AssemblerAPI: free developer account at https://www.assemblerapi.co
#ASSEMBLER_API_KEY=your_key_here
#ASSEMBLER_MODEL=eas-v1

# --- Paid options ---
# OpenAI Whisper API (requires API credit balance)
#OPENAI_API_KEY=sk-your_key_here
